{
  "manifest_version": 3,
  "name": "Human Search Assistant",
  "description": "Local Microsoft Rewards task status viewer with state-first click assistance, bilingual UI and scheduled runs.",
  "version": "1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://bing.com/*",
    "https://*.bing.com/*",
    "https://top.baidu.com/*",
    "https://weibo.com/*",
    "https://www.toutiao.com/*",
    "https://www.zhihu.com/*",
    "https://rss.sina.com.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Human Search Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
