{
  "manifest_version": 3,
  "name": "拟人搜索助手",
  "short_name": "HumanSearch",
  "version": "4.2.0",
  "description": "仅保留拟人搜索：随机真实热搜词、可设置搜索次数与多个每日定时启动点、点击停止立即中止；搜索进行时工具栏扩展图标变红。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/idle_16.png",
    "32": "icons/idle_32.png",
    "48": "icons/idle_48.png",
    "128": "icons/idle_128.png"
  },
  "action": {
    "default_title": "拟人搜索助手 · 空闲",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/idle_16.png",
      "32": "icons/idle_32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.bing.com/*",
    "https://top.baidu.com/*",
    "https://weibo.com/*",
    "https://www.toutiao.com/*",
    "https://www.zhihu.com/*",
    "https://rss.sina.com.cn/*"
  ]
}
