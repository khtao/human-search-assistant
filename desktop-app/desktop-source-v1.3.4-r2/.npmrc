# ============================================================================
# 国内网络安装配置（npmmirror 镜像站）
# 文档：https://npmmirror.com —— 完整 npmjs.com 只读镜像，与官方实时同步
# ============================================================================

# 只保留 npm 内置配置项。npm 11+ 会对项目 .npmrc 里的未知 project config
# 报 "Unknown project config ... This will stop working in the next major
# version of npm." 警告（用户 Ubuntu 日志里的三条）。
# Electron 二进制 / electron-builder 工具链的镜像改由 scripts/npm-mirror.js
# 以环境变量方式注入，功能不变、且不再有警告。
registry=https://registry.npmmirror.com/

# 减少安装阶段的额外网络请求（均为 npm 内置键）
audit=false
fund=false
