{
  "name": "human-search-assistant-desktop",
  "version": "1.3.4",
  "description": "拟人搜索助手 · 跨平台桌面版（Windows / Ubuntu）",
  "main": "main.js",
  "author": "local",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node scripts/launch.js",
    "verify": "node scripts/verify-v120.js && node scripts/verify-github-align.js && node scripts/verify-v130-flow.js && node scripts/verify-v131.js && node scripts/verify-main.js && node scripts/verify-sync.js && node scripts/verify-install.js && node scripts/verify-deps.js && node scripts/verify-launch.js",
    "verify:render": "python3 scripts/verify-render.py",
    "fix:electron": "node scripts/fix-electron.js",
    "build:linux": "sh scripts/build-linux.sh",
    "dist": "electron-builder",
    "dist:win": "electron-builder --config electron-builder.win.yml --win --x64",
    "dist:linux": "electron-builder --config electron-builder.yml --linux deb --x64",
    "pack:win": "electron-builder --config electron-builder.win.yml --win --x64 --dir",
    "pack:linux": "electron-builder --config electron-builder.yml --linux --x64 --dir",
    "verify:sync": "node scripts/verify-sync.js",
    "prestart": "node scripts/check-electron.js",
    "doctor": "node scripts/check-electron.js --verbose",
    "fix:electron:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-electron.ps1",
    "verify:install": "node scripts/verify-install.js",
    "verify:e2e": "node scripts/verify-logged-in-e2e.js",
    "setup": "node scripts/npm-mirror.js install && npm run doctor && npm start",
    "verify:deps": "node scripts/verify-deps.js",
    "debug:pack": "node scripts/pack-debug.js",
    "debug:dir": "node -e \"console.log(require('path').join(__dirname,'debug-captures'))\"",
    "verify:debug": "node scripts/verify-debug.js",
    "start:debug": "node scripts/start-debug.js",
    "verify:real": "node scripts/verify-real-html.js",
    "verify:v120": "node scripts/verify-v120.js",
    "verify:align": "node scripts/verify-github-align.js",
    "verify:v130": "node scripts/verify-v130-flow.js",
    "verify:v131": "node scripts/verify-v131.js",
    "verify:v132": "node scripts/verify-v132.js",
    "verify:v133": "node scripts/verify-v133.js",
    "ci": "node scripts/npm-mirror.js ci",
    "verify:launch": "node scripts/verify-launch.js",
    "dist:deb": "electron-builder --config electron-builder.yml --linux deb --x64",
    "dist:appimage": "electron-builder --config electron-builder.yml --linux AppImage --x64",
    "verify:browser": "node scripts/verify-v132.js && node scripts/verify-v133.js && node scripts/verify-debug.js && node scripts/verify-real-html.js"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
