{
  "manifest_version": 3,
  "name": "拟人搜索助手",
  "description": "同步 Bing Rewards 积分与任务，按主界面任务状态点击侧栏任务卡；空闲静默、低内存占用。",
  "version": "1.6",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "https://bing.com/*",
    "https://*.bing.com/*",
    "https://top.baidu.com/*",
    "https://weibo.com/*",
    "https://www.toutiao.com/*",
    "https://www.zhihu.com/*",
    "https://rss.sina.com.cn/*",
    "https://ipwho.is/*",
    "https://ipapi.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Human Search Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src https://*.bing.com https://bing.com;"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cn.bing.com/rewards/panelflyout*",
        "https://www.bing.com/rewards/panelflyout*"
      ],
      "js": [
        "flyout-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}